# AquaPets backend production environment
# Copy to .env on the production host and replace every placeholder.

NODE_ENV=production
PORT=5000
TRUST_PROXY=1

# Set this to the exact deployed frontend origin, without a trailing slash.
CORS_ORIGIN=https://aquapets.com

# Generate a 64-byte random hex secret with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex_secret
JWT_EXPIRES=15m

# Use a unique password manager-generated password before first production boot.
ADMIN_USERNAME=replace_admin_username
ADMIN_PASSWORD=replace_admin_password
ADMIN_EMAIL=admin@aquapets.com
ADMIN_NAME=AquaPets Admin

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
ADMIN_RATE_LIMIT_MAX=1000
REFRESH_EXPIRES_DAYS=30
MORGAN_FORMAT=combined

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=2097152
