# AquaPets backend environment variables example
# Copy to .env and fill values for production. Do NOT commit .env to source control.

# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=0

# CORS
# Set to your frontend origin in production, e.g. https://myshop.example.com
CORS_ORIGIN=*

# JWT
# IMPORTANT: set a long-random secret in production
JWT_SECRET=your_production_jwt_secret_here
JWT_EXPIRES=7d

# Admin bootstrap credentials (change immediately in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_local_password
ADMIN_EMAIL=admin@aquapets.local
ADMIN_NAME=Site Admin

# Rate limiting
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15
ADMIN_RATE_LIMIT_MAX=1000

# Refresh tokens
REFRESH_EXPIRES_DAYS=30

# Logging
MORGAN_FORMAT=combined
 
# File uploads
UPLOAD_DIR=uploads
# Max upload size in bytes (default 2MB)
UPLOAD_MAX_SIZE=2097152

